{
  "name": "postgres-sink",
  "config": {
    "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
    "tasks.max": "2",
    "topics": "countries,departments,customers,addresses,product_categories,suppliers,products,warehouses,inventory,orders,order_items,payments,shipments,employees,timesheets,invoices,support_tickets,product_reviews,vehicles,data_sensors",
    "connection.url": "jdbc:postgresql://postgres:5432/demo",
    "connection.user": "postgres",
    "connection.password": "postgres",
    "key.converter": "io.confluent.connect.avro.AvroConverter",
    "key.converter.schema.registry.url": "http://schema-registry:8081",
    "value.converter": "io.confluent.connect.avro.AvroConverter",
    "value.converter.schema.registry.url": "http://schema-registry:8081",
    "table.name.format": "${topic}",
    "pk.mode": "record_key",
    "insert.mode": "upsert",
    "delete.enabled": "true",
    "auto.create": "false",
    "auto.evolve": "false"
  }
}
