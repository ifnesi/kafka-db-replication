# Copy to .env (cp .env_example .env), fill in the values and keep it private: .env is git-ignored.
# start.sh, stop.sh and lightning-tables.sh read it; values already exported in your shell take precedence.

# --- Terraform (start.sh / stop.sh) ---------------------------------------------------------
# Cloud API key with the "Cloud resource management" scope
# (Confluent Cloud > API keys > Add API key > My account > Cloud resource management)
CONFLUENT_CLOUD_API_KEY=
CONFLUENT_CLOUD_API_SECRET=

# --- Lightning Tables over JDBC (lightning-tables.sh) and the Confluent MCP server ----------
# Global API key (Confluent Cloud > API keys > Add API key > My account > Global access).
# A Cloud resource management key or a cluster-scoped key is rejected with HTTP 401.
CONFLUENT_GLOBAL_API_KEY=
CONFLUENT_GLOBAL_API_SECRET=

# --- Optional ----------------------------------------------------------------------------------
# Topics to enable Lightning Tables on (AWS clusters only, space separated)
# TOPICS="data_sensors customers orders products"
# Terraform overrides, for example another region
# TF_VAR_cc_cloud_region=eu-central-1
