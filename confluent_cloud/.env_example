# Copy to .env (cp .env_example .env), fill in the values and keep it private: .env is git-ignored.
# start.sh, stop.sh, deploy-connectors.sh, lightning-tables.sh and confluent-mcp.sh read it; values already exported in your shell take precedence.

# --- Terraform (start.sh / stop.sh) ---------------------------------------------------------
# Cloud API key with the "Cloud resource management" scope
# (Confluent Cloud > API keys > Add API key > My account > Cloud resource management)
CONFLUENT_CLOUD_API_KEY=
CONFLUENT_CLOUD_API_SECRET=

# --- Lightning Tables over JDBC (lightning-tables.sh) and the Confluent MCP server ----------
# Global API key (Confluent Cloud > API keys > Add API key > My account > Global access).
# A Cloud resource management key or a cluster-scoped key is rejected with HTTP 401.
CONFLUENT_GLOBAL_API_KEY=
CONFLUENT_GLOBAL_API_SECRET=

# --- Optional features (true/false, default false) --------------------------------------------
# Lightning Tables: deploy-connectors.sh enables them on $TOPICS (via ./lightning-tables.sh) once
# the source has registered the schemas. Needs the Global API key above and DBeaver to query.
ENABLE_LIGHTNING_TABLES=false
# Confluent MCP server: start.sh registers the managed MCP servers in Claude Code (./confluent-mcp.sh),
# stop.sh removes them when the environment is destroyed. Needs the Global API key and the claude CLI.
ENABLE_CONFLUENT_MCP=false
# Claude Code scope for the MCP servers: user (all projects) or local (this folder only)
# CONFLUENT_MCP_SCOPE=user

# --- Optional ----------------------------------------------------------------------------------
# deploy-connectors.sh restarts a hung SQL Server container before deploying (1, default) or only reports it (0)
# MSSQL_AUTO_RESTART=1
# Kafbat UI login (http://localhost:8080), default devops / Devops123
# KAFBAT_USER=devops
# KAFBAT_PASSWORD=Devops123
# Topics to enable Lightning Tables on (AWS clusters only, space separated)
# TOPICS="cdc.data_sensors cdc.customers cdc.orders cdc.products"
# Terraform overrides, for example another region
# TF_VAR_cc_cloud_region=eu-central-1
