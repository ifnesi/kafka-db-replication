{
  "name": "db2-sink",
  "config": {
    "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
    "tasks.max": "2",
    "topics": "cdc.countries,cdc.departments,cdc.customers,cdc.addresses,cdc.product_categories,cdc.suppliers,cdc.products,cdc.warehouses,cdc.inventory,cdc.orders,cdc.order_items,cdc.payments,cdc.shipments,cdc.employees,cdc.timesheets,cdc.invoices,cdc.support_tickets,cdc.product_reviews,cdc.vehicles,cdc.data_sensors",
    "connection.url": "jdbc:db2://db2:50000/demo",
    "connection.user": "db2inst1",
    "connection.password": "db2inst1-pwd",
    "consumer.override.security.protocol": "SASL_SSL",
    "consumer.override.sasl.mechanism": "PLAIN",
    "consumer.override.sasl.jaas.config": "org.apache.kafka.common.security.plain.PlainLoginModule required username=\"${env:CC_DB2SINK_KAFKA_API_KEY}\" password=\"${env:CC_DB2SINK_KAFKA_API_SECRET}\";",
    "key.converter": "io.confluent.connect.avro.AvroConverter",
    "key.converter.schema.registry.url": "${env:CC_SR_URL}",
    "key.converter.basic.auth.credentials.source": "USER_INFO",
    "key.converter.basic.auth.user.info": "${env:CC_DB2SINK_SR_API_KEY}:${env:CC_DB2SINK_SR_API_SECRET}",
    "key.converter.schema.registry.basic.auth.user.info": "${env:CC_DB2SINK_SR_API_KEY}:${env:CC_DB2SINK_SR_API_SECRET}",
    "value.converter": "io.confluent.connect.avro.AvroConverter",
    "value.converter.schema.registry.url": "${env:CC_SR_URL}",
    "value.converter.basic.auth.credentials.source": "USER_INFO",
    "value.converter.basic.auth.user.info": "${env:CC_DB2SINK_SR_API_KEY}:${env:CC_DB2SINK_SR_API_SECRET}",
    "value.converter.schema.registry.basic.auth.user.info": "${env:CC_DB2SINK_SR_API_KEY}:${env:CC_DB2SINK_SR_API_SECRET}",
    "transforms": "dropPrefix",
    "transforms.dropPrefix.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.dropPrefix.regex": "cdc\\.(.*)",
    "transforms.dropPrefix.replacement": "$1",
    "table.name.format": "${topic}",
    "pk.mode": "record_key",
    "insert.mode": "upsert",
    "delete.enabled": "true",
    "auto.create": "false",
    "auto.evolve": "false"
  }
}
